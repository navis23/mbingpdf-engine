{
  "compilerOptions": {
    "target": "es2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client", "node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "paths": {
      "mbingpdf": ["../packages/mbingpdf/src/index.ts"],
      "mbingpdf/svg": ["../packages/mbingpdf/src/svg/index.ts"]
    }
  },
  "include": ["src", "build", "vite.config.ts"]
}
