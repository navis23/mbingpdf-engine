{
  "name": "@mbingpdf/vue",
  "version": "0.1.0",
  "description": "Vue components and composables for previewing and downloading mbingpdf documents.",
  "license": "MIT",
  "author": "Navis Zarkasy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navis23/mbingpdf-engine.git",
    "directory": "packages/vue"
  },
  "keywords": [
    "pdf",
    "vue",
    "nuxt",
    "preview",
    "mbingpdf"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "peerDependencies": {
    "mbingpdf": "workspace:^",
    "vue": ">=3.5"
  },
  "devDependencies": {
    "happy-dom": "^21.0.4",
    "mbingpdf": "workspace:^",
    "vue": "^3.5.45"
  },
  "homepage": "https://mbingpdf.enterbiner.com",
  "bugs": {
    "url": "https://github.com/navis23/mbingpdf-engine/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
