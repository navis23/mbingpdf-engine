{
  "name": "@mbingpdf/dev",
  "version": "0.1.1",
  "description": "Preview server and command line for mbingpdf documents: see the pages re-render as you save.",
  "license": "MIT",
  "author": "Navis Zarkasy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navis23/mbingpdf-engine.git",
    "directory": "packages/dev"
  },
  "keywords": [
    "pdf",
    "preview",
    "cli",
    "mbingpdf"
  ],
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "bin": {
    "mbingpdf": "./dist/cli.mjs"
  },
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "rolldown": "^1.3.1"
  },
  "peerDependencies": {
    "mbingpdf": "workspace:^"
  },
  "devDependencies": {
    "mbingpdf": "workspace:^"
  },
  "homepage": "https://mbingpdf.enterbiner.com",
  "bugs": {
    "url": "https://github.com/navis23/mbingpdf-engine/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
