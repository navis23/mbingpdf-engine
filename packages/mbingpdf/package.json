{
  "name": "mbingpdf",
  "version": "0.0.0",
  "description": "Generate production-grade PDF documents in any JavaScript runtime.",
  "license": "MIT",
  "author": "Navis Zarkasy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navis23/mbingpdf-engine.git",
    "directory": "packages/mbingpdf"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "typescript",
    "layout",
    "print",
    "invoice",
    "report",
    "pdf-x",
    "svg",
    "qr-code"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core/index.d.ts",
        "default": "./dist/core/index.js"
      },
      "require": {
        "types": "./dist/core/index.d.cts",
        "default": "./dist/core/index.cjs"
      }
    },
    "./font": {
      "import": {
        "types": "./dist/font/index.d.ts",
        "default": "./dist/font/index.js"
      },
      "require": {
        "types": "./dist/font/index.d.cts",
        "default": "./dist/font/index.cjs"
      }
    },
    "./image": {
      "import": {
        "types": "./dist/image/index.d.ts",
        "default": "./dist/image/index.js"
      },
      "require": {
        "types": "./dist/image/index.d.cts",
        "default": "./dist/image/index.cjs"
      }
    },
    "./qr": {
      "import": {
        "types": "./dist/qr/index.d.ts",
        "default": "./dist/qr/index.js"
      },
      "require": {
        "types": "./dist/qr/index.d.cts",
        "default": "./dist/qr/index.cjs"
      }
    },
    "./svg": {
      "import": {
        "types": "./dist/svg/index.d.ts",
        "default": "./dist/svg/index.js"
      },
      "require": {
        "types": "./dist/svg/index.d.cts",
        "default": "./dist/svg/index.cjs"
      }
    },
    "./text": {
      "import": {
        "types": "./dist/text/index.d.ts",
        "default": "./dist/text/index.js"
      },
      "require": {
        "types": "./dist/text/index.d.cts",
        "default": "./dist/text/index.cjs"
      }
    },
    "./jsx-runtime": {
      "import": {
        "types": "./dist/jsx-runtime.d.ts",
        "default": "./dist/jsx-runtime.js"
      },
      "require": {
        "types": "./dist/jsx-runtime.d.cts",
        "default": "./dist/jsx-runtime.cjs"
      }
    },
    "./jsx-dev-runtime": {
      "import": {
        "types": "./dist/jsx-dev-runtime.d.ts",
        "default": "./dist/jsx-dev-runtime.js"
      },
      "require": {
        "types": "./dist/jsx-dev-runtime.d.cts",
        "default": "./dist/jsx-dev-runtime.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test:runtime:node": "node test/harness/runtime.mjs",
    "test:runtime:deno": "deno run --allow-read test/harness/runtime.mjs",
    "test:runtime:bun": "bun test/harness/runtime.mjs",
    "test:runtime:browser": "node test/harness/browser.mjs",
    "size": "node scripts/size.mjs"
  },
  "devDependencies": {
    "@hyzyla/pdfium": "^3.0.0",
    "@napi-rs/canvas": "^1.1.0",
    "@types/pngjs": "^6.0.5",
    "fflate": "0.8.3",
    "harfbuzzjs": "^1.6.4",
    "jsqr": "^1.4.0",
    "pdfjs-dist": "^6.5.438",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0"
  },
  "homepage": "https://github.com/navis23/mbingpdf-engine#readme",
  "bugs": {
    "url": "https://github.com/navis23/mbingpdf-engine/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
