{
  "name": "mbingpdf",
  "version": "0.0.0",
  "description": "Generate production-grade PDF documents in any JavaScript runtime.",
  "license": "MIT",
  "author": "Navis Zarkasy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/navis23/mbingpdf-engine.git",
    "directory": "packages/mbingpdf"
  },
  "keywords": [
    "pdf",
    "pdf-generation",
    "typescript",
    "layout",
    "print"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./core": {
      "import": "./dist/core/index.js",
      "require": "./dist/core/index.cjs"
    },
    "./font": {
      "import": "./dist/font/index.js",
      "require": "./dist/font/index.cjs"
    },
    "./image": {
      "import": "./dist/image/index.js",
      "require": "./dist/image/index.cjs"
    },
    "./text": {
      "import": "./dist/text/index.js",
      "require": "./dist/text/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test:runtime:node": "node test/harness/runtime.mjs",
    "test:runtime:deno": "deno run --allow-read test/harness/runtime.mjs",
    "test:runtime:bun": "bun test/harness/runtime.mjs",
    "test:runtime:browser": "node test/harness/browser.mjs"
  },
  "devDependencies": {
    "@hyzyla/pdfium": "^3.0.0",
    "@napi-rs/canvas": "^1.1.0",
    "@types/pngjs": "^6.0.5",
    "fflate": "0.8.3",
    "harfbuzzjs": "^1.6.4",
    "pdfjs-dist": "^6.5.438",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.65.0",
    "pngjs": "^7.0.0"
  }
}
